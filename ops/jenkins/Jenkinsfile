// Pull-request gate of the Domincipe monorepo (changes ci-pipeline and ci-integration).
//
// Declarative pipeline. ci-pipeline landed the skeleton —the agent label of design D8, the
// retention of D10 and the always-post that archives—, the quality stages, the images, their
// references, the build parity, the SBOM and the vulnerability scan. ci-integration added the
// test daemon of the stack and, with it, the levels that need one: integration inside the
// backend half, and the e2e plus the environment battery in the second group.
//
// Nothing here omits tests or lowers a threshold: those options are exactly what PROJECT.md §8
// forbids, and the whole suite of the tree runs in one Maven invocation.
//
// The helpers under ops/jenkins/vars/ are loaded by path instead of being a
// registered global library: a library is resolved from an SCM, and the commit
// that introduces it cannot be in that SCM yet. Loading them from the workspace
// checkout keeps the helpers versioned with the pipeline that uses them.

pipeline {
    // The label the JCasC node declares (design D8): moving the builds to an
    // agent later is a label change, not a pipeline rewrite.
    agent { label 'ci' }

    options {
        // Retention of a live job (design D10). The orphaned-item strategy in
        // casc/jenkins.yaml covers the jobs that disappear instead.
        buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '30'))
    }

    environment {
        // vite.config.ts aborts build and test when this variable is missing, so
        // the gate has to define it (web-shell spec). The value is the same
        // default scripts/build-images.sh bakes into the local bundle, which
        // keeps the build-arg of the image stage identical (design D3, task 6.1).
        VITE_API_BASE_URL = 'http://localhost:8080'
        // The rootless builder's Unix socket, shared with the controller through
        // the buildkit-run volume (design D2). It is defined once here: the
        // `debug workers` probe and ciBuildImage.groovy read this same variable,
        // so the address cannot drift between the two.
        BUILDKIT_HOST = 'unix:///run/user/1000/buildkit/buildkitd.sock'
        // The test daemon of the stack (change ci-integration, design D1). It is reached over
        // ci-net by service name, never through a socket: no container of the stack mounts the
        // host's. Declared once here so the integration, e2e and environment stages cannot
        // disagree about which daemon they are talking to.
        DOCKER_HOST = 'tcp://dind:2375'
        // Testcontainers publishes the ports of its containers on the daemon's host, which is
        // the dind container and not the controller: without this override the client would call
        // 127.0.0.1 and get a connection refused for every container (design D4).
        TESTCONTAINERS_HOST_OVERRIDE = 'dind'
        // The browser runner of the smoke: the official image of the pinned Playwright version,
        // with Chromium and its libraries inside. The same value the overlay of the e2e project
        // defaults to, declared here because the stage also creates the container by hand.
        PLAYWRIGHT_IMAGE = 'mcr.microsoft.com/playwright:v1.65.0-noble@sha256:9beb546099e11f52d62e505537914870e01a67e0e6b00ae41da4775324e73dbe'
        // The GitHub repository the build result is published to, and the API
        // it is published through (task 8.1). It is the same repository the
        // branch source polls, so the status lands on the commit the build was
        // started from.
        GITHUB_REPOSITORY = 'dominguezvazquezdavid/domincipe'
        GITHUB_API_URL = 'https://api.github.com'
        // Name of the check this pipeline publishes. Task 8.2 requires exactly
        // this name in the protection of develop and main, and task 8.3
        // documents it, so it is declared once, here.
        CI_STATUS_CONTEXT = 'domincipe'
    }

    stages {
        // First group (change ci-integration, design D3). The three branches are independent —
        // Maven, npm and BuildKit share nothing but the checkout — so they run at the same time
        // and the gate lasts as long as the slower one instead of the sum. failFast marks the
        // build red as soon as one fails instead of waiting for its siblings; it aborts nothing
        // that was going to change the verdict, and a green branch is never reported as a pass
        // for the build. A failure in any branch is a FAILURE of the build.
        stage('Quality') {
            failFast true
            parallel {
                // The daemon probe goes before Maven: the backend half now runs the integration
                // level too, so a daemon that is not there would surface as a Testcontainers
                // timeout much later and hide the cause. It fails naming the daemon and the
                // command that starts it (change ci-integration, design D8), and it is not a
                // gate parameter: the level it protects is mandatory.
                stage('Backend') {
                    steps {
                        sh '''
                            docker info --format 'DOCKER_HOST={{.DockerRootDir}} server={{.ServerVersion}}' \
                              || { echo "backend: the test daemon at ${DOCKER_HOST} does not answer; start the CI stack with 'docker compose -f ops/jenkins/docker-compose.yml up --wait'" >&2; exit 1; }
                        '''
                        // `clean` is the one difference from the chain §8 runs
                        // by hand, and the workspace is why: the one of a branch
                        // or PR job survives between builds, so the XML left in
                        // target/surefire-reports by an earlier red build is
                        // still there when the junit step of a green one reads
                        // the directory, and it turns that green build UNSTABLE.
                        // Reproduced in task 9.1: the fixing commit deleted the
                        // deliberate test, Maven finished BUILD SUCCESS and the
                        // build still reported the deleted test as a failure —
                        // and the status, published before junit, called it a
                        // success while Jenkins was marking it UNSTABLE.
                        //
                        // One invocation for the whole suite, integration included:
                        // failsafe is bound in every module, so `verify` runs the
                        // *IT.java of the tree against the test daemon. Two Maven runs
                        // (one for unit, one for ITs) would fight over target/, and
                        // -DskipITs here is exactly what PROJECT.md §8 forbids.
                        sh './mvnw -B -ntp clean verify'
                    }
                }
                // Same chain PROJECT.md §8 runs by hand: reproducible install
                // from the lock file, lint, type-check plus bundle and tests.
                // npm keeps its cache in ~/.npm, which is the npm-cache volume
                // of the controller, so a second build does not download the
                // registry again. VITE_API_BASE_URL comes from the pipeline
                // environment: without it vite.config.ts fails. `dir` is
                // thread-scoped, so this branch works in its own directory
                // while the Backend branch builds at the root of the checkout.
                stage('Frontend') {
                    steps {
                        dir('apps/web-frontend') {
                            sh 'npm ci'
                            sh 'npm run lint'
                            sh 'npm run build'
                            sh 'npm test'
                        }
                    }
                }
            }
            // Images joins the first group (change ci-integration, design D3): it builds against
            // buildkitd, not against the test daemon, and the build context excludes target/,
            // node_modules/ and dist/ (.dockerignore), so it shares no file with Maven or npm.
            // A stage that can run earlier without contending anything is time the gate does not
            // spend twice.
            stage('Images') {
                steps {
                    script {
                        // Artefacts in /out are per build — the OCI archives and,
                        // from task 7.2 on, the layouts extracted from them — so the
                        // stage starts by emptying the volume instead of letting it
                        // grow with every run (design D3, checked in task 6.5).
                        sh 'find /out -mindepth 1 -maxdepth 1 -exec rm -rf {} +'

                        // Ask the daemon for its workers before building: an
                        // unreachable socket fails here with the builder's own
                        // message, not as a build that looks slow on a cold cache
                        // (design D3, same probe as the compose healthcheck).
                        sh 'buildctl debug workers'

                        // Short SHA computed exactly as scripts/build-images.sh does
                        // it. The immutable reference and the
                        // org.opencontainers.image.revision label have to be the
                        // same string in the local build and in the CI build of one
                        // commit (design D3, checked in task 6.3).
                        def sha = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()

                        def buildImage = load('ops/jenkins/vars/ciBuildImage.groovy')

                        // Same Dockerfiles, build args and MODULE values as the
                        // local script, so only the builder differs between the two
                        // paths (design D3). One buildctl call per image writes one
                        // OCI archive with the sha and the latest reference, which is
                        // what makes them unable to drift apart.
                        [
                            [image: 'api-gateway',          dockerfile: 'java-service.Dockerfile',   buildArgs: [MODULE: 'apps/api-gateway']],
                            [image: 'auth-service',         dockerfile: 'java-service.Dockerfile',   buildArgs: [MODULE: 'apps/services/auth-service']],
                            [image: 'user-service',         dockerfile: 'java-service.Dockerfile',   buildArgs: [MODULE: 'apps/services/user-service']],
                            [image: 'recipe-service',       dockerfile: 'java-service.Dockerfile',   buildArgs: [MODULE: 'apps/services/recipe-service']],
                            [image: 'media-service',        dockerfile: 'java-service.Dockerfile',   buildArgs: [MODULE: 'apps/services/media-service']],
                            [image: 'notification-service', dockerfile: 'java-service.Dockerfile',   buildArgs: [MODULE: 'apps/services/notification-service']],
                            // The SPA bakes the API endpoint in at build time: without
                            // it vite.config.ts fails (web-shell spec). The value is
                            // the pipeline environment one, which equals the local
                            // script's default (design D3).
                            [image: 'web-frontend',         dockerfile: 'web-frontend.Dockerfile',   buildArgs: [VITE_API_BASE_URL: env.VITE_API_BASE_URL]],
                        ].each { entry ->
                            buildImage.call(entry + [sha: sha])
                        }

                        // Both references of every archive must resolve to the same
                        // manifest (task 6.2). The single --output of D3 is designed
                        // to make them inseparable; this turns that into a checked
                        // property, so a divergent pair fails the build here instead
                        // of shipping two tags of different images.
                        sh "./scripts/ci-verify-oci-refs.sh --sha '${sha}' /out/*.tar"

                        // Same Dockerfiles, same build args and the same revision
                        // label as the local scripts/build-images.sh path, checked
                        // on the archives just built (task 6.3). The gate passes the
                        // seven archives; --local is the host spot check that
                        // compares an archive against the local image of the commit.
                        sh "./scripts/ci-verify-build-parity.sh --sha '${sha}' /out/*.tar"
                    }
                }
            }
        }

        // Second group (change ci-integration, design D3): everything here consumes what the
        // first group produced —the archives of Images, or the environment they are loaded
        // into— and the three branches touch different resources, so they run together.
        stage('Verification') {
            failFast true
            parallel {
                // Integration, e2e and the environment battery (change ci-integration). The
                // environment is a Compose project of its own, raised inside the dind container
                // and publishing no port, so it neither collides with the development
                // environment nor with the Jenkins port.
                stage('E2E') {
                    steps {
                        sh '''
                            set -eu
                            # The battery scripts read COMPOSE_FILE exactly like the canonical
                            # `up --wait`, so pointing it at base + ci makes them inspect this
                            # project and no other (the project name comes from the ci file).
                            export COMPOSE_FILE=ops/compose/docker-compose.base.yml:ops/compose/docker-compose.ci.yml
                            # The same commit identifier ciGitSha hands to ciBuildImage, so the
                            # tag below names an image that exists: APP_IMAGE_TAG is what the
                            # base file interpolates into every image reference.
                            sha="${GIT_COMMIT:-$(git rev-parse HEAD)}"
                            export APP_IMAGE_TAG="${sha}"

                            echo 'E2E: recreating the test project from zero'
                            docker compose --profile e2e --profile battery down -v --remove-orphans || true

                            # The images the Images stage certified, not a rebuild: what the smoke
                            # runs has to be exactly what passed the parity check (design D5).
                            for archive in /out/*.tar; do
                                if [ ! -f "${archive}" ]; then
                                    echo 'E2E: no OCI archive under /out; the Images stage has to run first' >&2
                                    exit 1
                                fi
                                docker load -i "${archive}"
                            done

                            echo "E2E: starting the environment as ${APP_IMAGE_TAG}"
                            docker compose --profile e2e --profile battery up --wait --wait-timeout 600

                            echo 'E2E: verifying the provisioned data'
                            ./scripts/verify-environment.sh

                            echo 'E2E: verifying the ordered shutdown of api-gateway'
                            ./scripts/verify-shutdown.sh --client-service=battery-client

                            # The workspace lives on the controller and the daemon is remote, so a
                            # bind mount would be resolved over there and find nothing: the test
                            # sources travel as an archive copied into the container.
                            network="$(docker network ls \
                                --filter label=com.docker.compose.project=domincipe-ci-e2e \
                                --filter label=com.docker.compose.network=frontend-net \
                                --format '{{.Name}}')"
                            if [ -z "${network}" ]; then
                                echo 'E2E: the frontend network of the project was not found' >&2
                                exit 1
                            fi
                            rm -rf e2e-artifacts
                            mkdir -p e2e-artifacts
                            tar -cf /tmp/e2e-source.tar -C apps/web-frontend \
                                package.json package-lock.json playwright.config.ts e2e

                            echo 'E2E: running the browser smoke'
                            runner="$(docker create --name domincipe-e2e-runner --network "${network}" \
                                -e E2E_BASE_URL=http://web-frontend:8080 \
                                -e E2E_GATEWAY_URL=http://api-gateway:8080 \
                                "${PLAYWRIGHT_IMAGE}" \
                                sh -lc 'set -e; mkdir -p /tmp/work && cd /tmp/work; tar -xf /tmp/e2e-source.tar; npm ci --no-audit --no-fund >/dev/null; npx playwright test')"
                            docker cp /tmp/e2e-source.tar "${runner}":/tmp/e2e-source.tar
                            status=0
                            docker start -a "${runner}" || status=$?
                            # Evidence even when the smoke passes: the junit report is what the
                            # pipeline publishes, and the traces only exist on failure.
                            docker cp "${runner}":/tmp/work/e2e/junit-results.xml e2e-artifacts/ 2>/dev/null || true
                            docker cp "${runner}":/tmp/work/e2e/test-results e2e-artifacts/ 2>/dev/null || true
                            docker rm -f "${runner}" >/dev/null 2>&1 || true

                            # Logs before the project disappears, so a red build can say why a
                            # container never became healthy.
                            docker compose --profile e2e --profile battery logs --no-color \
                                > e2e-artifacts/compose.log 2>&1 || true
                            docker compose --profile e2e --profile battery down -v --remove-orphans || true

                            if [ "${status}" -ne 0 ]; then
                                echo "E2E: the browser smoke failed (exit ${status}); see the archived traces" >&2
                                exit "${status}"
                            fi
                        '''
                    }
                }
                // Syft reads the OCI archive the Images stage wrote, so the inventory
                // needs neither a daemon nor a second export (design D4, task 7.1). The
                // archives themselves are the list: an image that was not built cannot
                // get an SBOM, and the matrix is not repeated here. /out is emptied at
                // the start of Images, so no archive from a previous build can slip in.
                // Output goes to the workspace `sbom/` directory, which is the glob the
                // always-post archives (ciArchiveReports.groovy, design D10).
                stage('SBOM') {
                    steps {
                        // --source-name and --source-version fill the CycloneDX
                        // metadata component: on its own, Syft names an archive by its
                        // path, and the spec requires each SBOM to identify its image
                        // and the commit that produced it. The short sha is derived as
                        // in the Images stage, so it matches the archive's tag.
                        sh '''
                            rm -rf sbom
                            mkdir -p sbom
                            set -- /out/*.tar
                            if [ ! -f "$1" ]; then
                                echo 'SBOM: no OCI archive under /out; the Images stage has to run first' >&2
                                exit 1
                            fi
                            sha="$(git rev-parse --short HEAD)"
                            for archive in "$@"; do
                                image="${archive##*/}"
                                image="${image%.tar}"
                                echo "SBOM: ${image} at ${sha}"
                                syft --quiet --from oci-archive "$archive" \
                                  --source-name "domincipe/${image}" \
                                  --source-version "$sha" \
                                  -o "cyclonedx-json=sbom/${image}.cdx.json"
                            done
                        '''
                    }
                }
                // Trivy 0.76.2 reads a `docker save` tarball or an OCI layout on disk,
                // never an OCI archive (design D4: it fails with `stat …/index.json:
                // not a directory`), so each .tar is extracted once and the directory is
                // the scan input — no second export and no daemon. The layout shares the
                // fate of the archive it came from: the next Images run empties /out.
                //
                // The stage scans every archive before failing, because the report of a
                // red build is what diagnoses it (design D10). A finding listed in the
                // versioned ignore file does not fail the build; Trivy omits it from the
                // report, and the identifier with its justification and expiry lives in
                // that file, which is the versioned record of the exception (design D4,
                // D9; --show-suppressed is not used because on 0.76.2 it restores the
                // findings suppressed by status or VEX, not those of --ignorefile). The
                // severity and exit code are the gate of D9: relaxing them needs a spec
                // change, never a pipeline parameter.
                stage('Scan') {
                    steps {
                        sh '''
                            rm -rf security
                            mkdir -p security
                            set -- /out/*.tar
                            if [ ! -f "$1" ]; then
                                echo 'Scan: no OCI archive under /out; the Images stage has to run first' >&2
                                exit 1
                            fi
                            failed=''
                            for archive in "$@"; do
                                image="${archive##*/}"
                                image="${image%.tar}"
                                echo "Scan: ${image}"
                                mkdir -p "/out/${image}"
                                tar -xf "$archive" -C "/out/${image}"
                                if trivy image --input "/out/${image}" \
                                  --ignorefile "${WORKSPACE}/ops/jenkins/.trivyignore" \
                                  --severity HIGH,CRITICAL --exit-code 1 \
                                  --format json --output "security/${image}.json"; then
                                    echo "Scan: ${image} passed the HIGH/CRITICAL gate"
                                else
                                    echo "Scan: ${image} failed the HIGH/CRITICAL gate; see security/${image}.json" >&2
                                    failed="${failed} ${image}"
                                fi
                            done
                            if [ -n "${failed}" ]; then
                                echo "Scan: HIGH/CRITICAL findings in${failed}" >&2
                                exit 1
                            fi
                        '''
                    }
                }
            }
        }
    }

    post {
        // The archive goes first and the status in the `finally` (design D10 and
        // D7, corrected in task 9.1). Archiving first is what makes the status
        // describe the final result: `junit` can still turn a green build into
        // UNSTABLE, and a status published before it would announce a success
        // the build ends up not having. The `finally` is what keeps a failed
        // archive from leaving the gate without a verdict — an unpublishable
        // status would block the merge forever, because 8.2 requires it — and
        // the reports are already archived at that point.
        always {
            script {
                try {
                    load('ops/jenkins/vars/ciArchiveReports.groovy').call()
                } finally {
                    // The commit the build represents (ciGitSha: the PR head),
                    // published with the credential of the store by id — the PAT
                    // is masked in the log and never travels in the Jenkinsfile.
                    def sha = load('ops/jenkins/vars/ciGitSha.groovy').call()
                    load('ops/jenkins/vars/ciPublishStatus.groovy').call(sha: sha)
                }
            }
        }
    }
}
