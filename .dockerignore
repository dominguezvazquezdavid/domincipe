# Trim the build context to what the Docker stages copy: Git history, local
# build output and the SDD artifacts are never needed inside an image.

.git
.idea
.vscode

# Local build output of every tool.
**/target
**/node_modules
apps/web-frontend/dist
apps/web-frontend/coverage
coverage
tmp
*.log

# Documentation and change tracking live in the repository, not in the images.
openspec

# Pipeline output of the CI job: the SBOM and Scan stages write these two
# directories at the root of the workspace, which is the build context. Leaving
# them in makes `COPY . .` change between two builds of the same commit (803 kB
# in the first build, 6.42 MB in the second) and defeats the builder cache: the
# six Java `RUN mvn ... package` layers are rebuilt every time (task 9.2).
sbom
security

# Environment files are read by Compose and the CI preflight, never copied into
# an image. Without this rule `COPY . .` puts them in the build stage and
# `export-cache mode=max` keeps that intermediate layer (with the GitHub PAT) in
# the /cache volume of the controller.
**/.env

# Compose data volumes (task 7.4) must never reach a build.
ops/compose/.volumes
