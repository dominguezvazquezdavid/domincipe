# --- Secrets and local configuration (12-factor: only .env.example is versioned) ---
.env
.env.local
.env.*.local
!.env.example

# --- Java / Maven ---
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.mvn/timing.properties

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Coverage and test artifacts ---
coverage/
lcov.info
# Playwright writes its junit report outside outputDir on purpose, so
# `test-results/` does not cover it (playwright.config.ts).
junit-results.xml
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- IDE / editors (each one with its own local configuration) ---
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.project
.classpath
.settings/
*.swp
*~

# --- Operating system ---
.DS_Store
Thumbs.db
desktop.ini

# --- Docker/Compose volumes and temporary files ---
ops/compose/.volumes/
*.pid
*.log
tmp/
