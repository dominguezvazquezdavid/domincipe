<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared operational library for the Domincipe services: request correlation plus the
  auto-configuration every service inherits (actuator exposure, virtual threads, graceful
  shutdown and the mandatory APP_ENVIRONMENT). Internal artifact: its version is the parent's,
  declared once in the parent's dependencyManagement.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.domincipe</groupId>
        <artifactId>domincipe-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-observability</artifactId>
    <name>Common observability</name>
    <description>Request correlation and shared operational defaults for the Domincipe services.</description>

    <dependencies>
        <!--
          spring-boot-starter-webmvc, never spring-boot-starter-web: the 4.1.2 POM metadata of
          the latter marks it "deprecated in favor of spring-boot-starter-webmvc" (verified).
          This starter supplies OncePerRequestFilter, the servlet API and the MVC layer the
          filter and its tests need.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!--
          Actuator is a runtime feature of every service, so the library owns it instead of
          repeating it six times. In 4.1.2 this starter brings spring-boot-health (probes), the
          metrics autoconfiguration and, through it, the Prometheus scrape endpoint.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          Bean Validation: @Validated makes a missing or unknown APP_ENVIRONMENT fail the startup
          with a message that names it, and this starter brings hibernate-validator plus the
          jakarta.validation API the annotations compile against.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          The Prometheus scrape endpoint is conditional on PrometheusMeterRegistry, which only
          this registry provides. Version managed by the micrometer-bom imported by
          spring-boot-dependencies 4.1.2.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!--
          API documentation is a runtime feature every service publishes. The dependency is
          optional so the library can compile the auto-configuration without forcing springdoc on
          any consumer: each service declares springdoc explicitly, as its own contract requires.
          Version managed by the springdoc-openapi-bom imported in the parent.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          spring-boot-starter-test already brings spring-test (MockMvc), JUnit 5, AssertJ and
          Mockito (verified in its 4.1.2 POM), so a dedicated MVC slice starter is not needed
          for standalone MockMvc tests.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
