# Template of the local configuration. Copy it before starting anything:
#
#   cp .env.example .env
#
# .env is git-ignored, so it is the only place where the values of a machine
# live. Everything below is a development example: no real credential belongs in
# this file (repo-layout spec, "Plantilla sin secretos").

# ---------------------------------------------------------------------------
# Compose files
# ---------------------------------------------------------------------------
# The canonical start (`docker compose up --wait` from the repository root) uses
# these three files: the observability stack is part of the environment, not an
# optional profile (PROJECT.md §9). COMPOSE_FILE is a path list whose separator
# is ':' on POSIX and ';' on Windows, and the paths are resolved from the
# directory Compose runs in, i.e. the repository root.
#
# Escape hatch for machines with few resources: pass the first two files
# explicitly and leave this one out, because an explicit -f wins over
# COMPOSE_FILE.
COMPOSE_FILE=ops/compose/docker-compose.base.yml:ops/compose/docker-compose.dev.yml:ops/compose/docker-compose.obs.yml

# ---------------------------------------------------------------------------
# Applications (the six Java services and the frontend container)
# ---------------------------------------------------------------------------
# Mandatory for every Java service: common-observability refuses to start when
# it is missing or is not one of local, dev or obs (service-runtime spec).
APP_ENVIRONMENT=local

# Tag of the images Compose runs. `latest` is the moving pointer;
# scripts/build-images.sh also publishes the short git SHA, which is the
# immutable reference a rollback pins (PROJECT.md §9).
APP_IMAGE_TAG=latest

# Grace period Docker grants a container before SIGKILL. It has to stay above
# the 30s drain window that common-observability sets for
# spring.lifecycle.timeout-per-shutdown-phase, or an in-flight request would be
# killed mid-response.
APP_STOP_GRACE_PERIOD=40s

# Single switch for /v3/api-docs and /swagger-ui.html (springdoc-openapi). With
# false the services keep serving health and metrics.
APP_DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# PostgreSQL (one schema per service, created by postgres-init)
# ---------------------------------------------------------------------------
POSTGRES_USER=domincipe
POSTGRES_PASSWORD=domincipe
POSTGRES_DB=domincipe

# ---------------------------------------------------------------------------
# Kafka (KRaft, no ZooKeeper; topics created by kafka-init)
# ---------------------------------------------------------------------------
# Version registered in PROJECT.md §4.
KAFKA_IMAGE=apache/kafka:4.4.0

# Pinned instead of left to the image default, so every machine formats its log
# directories with the same identifier.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# Partitions of every topic of the event contract; the local cluster has a
# single broker, so the replication factor stays at 1.
KAFKA_TOPIC_PARTITIONS=3

# ---------------------------------------------------------------------------
# Object storage (Versity S3 Gateway over POSIX; bucket created by versity-init)
# ---------------------------------------------------------------------------
# Version registered in PROJECT.md §4.
S3_IMAGE=versity/versitygw:v1.11.0

# Root credentials of the gateway. Local examples only: a shared environment
# takes them from a secret manager, never from a file in the repository.
S3_ROOT_USER=domincipe
S3_ROOT_PASSWORD=domincipe-secret

# S3 requests are signed with a region even though Versity does not live in AWS.
S3_REGION=us-east-1

# Bucket that holds the recipe images (media-service).
MEDIA_BUCKET=domincipe-media

# ---------------------------------------------------------------------------
# Email (Mailpit: SMTP on 1025, UI and API on 8025)
# ---------------------------------------------------------------------------
# Sender address the future notification-service will use. Mailpit is a fake
# mailbox, so any placeholder is accepted (design, open question on MAIL_FROM).
MAIL_FROM=no-reply@domincipe.local

# ---------------------------------------------------------------------------
# Image build (scripts/build-images.sh)
# ---------------------------------------------------------------------------
# Repository prefix of the built images.
IMAGE_PREFIX=domincipe

# API endpoint baked into the frontend bundle at build time. The dev override
# gives port 8080 to api-gateway, so the default matches `docker compose up`.
VITE_API_BASE_URL=http://localhost:8080
