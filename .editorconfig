root = true

# Shared base: the same file must look the same on any machine.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml,xsd}]
indent_size = 4

[*.{md,markdown}]
# In Markdown, two trailing spaces are an intentional line break.
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc,js,jsx,ts,tsx,css,scss,html}]
indent_size = 2

[*.sql]
indent_size = 4

[Makefile]
indent_style = tab

[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 2

[{mvnw,.mvn/**}]
indent_size = 2

# Batch scripts are executed by cmd.exe, which expects CRLF. mvnw.cmd is
# generated that way by the official wrapper plugin, and rewriting it to LF
# produces a spurious diff on every save from the IDE (and breaks some
# `goto :label`).
[*.{cmd,bat}]
end_of_line = crlf
