root = true

# Base común: un mismo fichero debe verse igual en cualquier máquina.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml,xsd}]
indent_size = 4

[*.{md,markdown}]
# En Markdown los dos espacios finales son un salto de línea intencional.
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc,js,jsx,ts,tsx,css,scss,html}]
indent_size = 2

[*.sql]
indent_size = 4

[Makefile]
indent_style = tab

[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 2

[{mvnw,.mvn/**}]
indent_size = 2

# Los scripts por lotes los ejecuta cmd.exe, que espera CRLF. mvnw.cmd lo
# genera así el plugin oficial del wrapper, y reescribirlo a LF produce un
# diff espurio en cada guardado desde el IDE (y rompe algunos `goto :label`).
[*.{cmd,bat}]
end_of_line = crlf
